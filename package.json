{
  "name": "pamyat",
  "version": "1.0.0",
  "private": true,
  "description": "Память — сервис ухода за захоронениями",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "client": "yarn workspace @pamyat/client start",
    "executor": "yarn workspace @pamyat/executor start",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "yarn workspaces run typecheck",
    "test": "yarn workspaces run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "typescript": "~5.4.5"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=18"
  }
}
