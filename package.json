{
  "name": "pamyat",
  "version": "1.0.0",
  "private": true,
  "description": "Память — сервис ухода за захоронениями",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "client": "npm start -w @pamyat/client",
    "executor": "npm start -w @pamyat/executor",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "check": "npm run typecheck && npm run lint && node tools/check-icons.js && npm test",
    "e2e:live": "cd e2e && node live-smoke.js"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-config-universe": "^16.1.2",
    "playwright-core": "^1.64.1",
    "prettier": "^3.3.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=18"
  }
}
