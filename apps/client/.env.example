# Скопируй в .env и заполни. .env не коммитится.

# Режим данных: true — фикстуры (демо), false — реальный бэкенд
EXPO_PUBLIC_USE_MOCKS=true

# Supabase (Project Settings → API). Нужны при EXPO_PUBLIC_USE_MOCKS=false
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Username Telegram-бота кодов входа, без @ (пусто — коды отключены)
EXPO_PUBLIC_TG_BOT=

# Собственный REST-бэкенд (фаза 3, пока не используется)
EXPO_PUBLIC_API_BASE_URL=https://api.pamyat.app/v1
