# Публичные переменные Expo (префикс EXPO_PUBLIC_ обязателен).
# Скопируйте в apps/client/.env

# Режим разработки без бэкенда — отдаёт мок-данные (по умолчанию включён).
# Поставьте false, когда появится реальный API.
EXPO_PUBLIC_USE_MOCKS=true

# API (когда бэкенд готов)
EXPO_PUBLIC_API_BASE_URL=https://api.pamyat.app/v1

# Яндекс Static API — необязателен. Без ключа превью карты открывает
# Яндекс.Карты по тапу; с ключом показывает картинку-миниатюру.
# Получить: https://developer.tech.yandex.ru/ (сервис «Static API»)
EXPO_PUBLIC_YANDEX_MAPS_API_KEY=

# Внешние сервисы (получить у тимлида) — задаются при сборке
FIREBASE_PROJECT_ID=
SENTRY_DSN=
AMPLITUDE_API_KEY=
YOOKASSA_SHOP_ID=
AWS_S3_BUCKET=
